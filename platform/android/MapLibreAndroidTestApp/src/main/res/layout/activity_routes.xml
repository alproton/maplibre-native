<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".activity.routes.RouteActivity"
        android:orientation="vertical">

    <org.maplibre.android.maps.MapView
        android:id="@id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:maplibre_cameraTargetLat="45.38301927899065"
        app:maplibre_cameraTargetLng="8.63525390625"
        app:maplibre_cameraZoom="7">

    </org.maplibre.android.maps.MapView>

    <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignEnd="@+id/mapView"
            android:orientation="vertical">

        <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/add_route"
                android:text="+Route"
                tools:ignore="HardcodedText"/>

        <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/remove_route"
                android:text="-Route"
                tools:ignore="HardcodedText"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/route_progress_precision_text"
                android:text="Progress Precision "
                android:textColor="#000000"
                tools:ignore="HardcodedText"/>

            <Spinner
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/route_progress_precision"
                android:background="@color/primary"
                />

        </LinearLayout>
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/log_route_snapshot"
            android:text="capture snapshot"
            tools:ignore="HardcodedText"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/capture_text"
                android:text="Captures "
                android:textColor="#000000"
                tools:ignore="HardcodedText"/>

            <Spinner
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/capture_entries"
                android:background="@color/primary"
                />

        </LinearLayout>

        <Button
            android:id="@+id/toggle_fps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toggle FPS"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fps_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FPS"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/fsp_view_value"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="NA"
                tools:ignore="HardcodedText"/>
        </LinearLayout>

        <Button
            android:id="@+id/refresh_mode_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toggle RefreshMode"
            tools:ignore="HardcodedText"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>


    </LinearLayout>

    <SeekBar
            android:id="@+id/route_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="16dp"
            android:max="100"
            android:progress="0"/>

</RelativeLayout>
